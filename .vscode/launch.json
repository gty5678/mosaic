{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Worker: main.py（uv，断点调试，无热重载）",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv: sync",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "DARKEYE_MAIN_BASE_URL": "http://127.0.0.1:56789"
      }
    },
    {
      "name": "Worker: uvicorn app:app（uv，热重载）",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "uv: sync",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "subProcess": true,
      "module": "uvicorn",
      "args": [
        "app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "56790",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "DARKEYE_MAIN_BASE_URL": "http://127.0.0.1:56789"
      }
    }
  ]
}
