{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Worker: main.py（断点调试，无热重载）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "DARKEYE_MAIN_BASE_URL": "http://127.0.0.1:56789"
      }
    },
    {
      "name": "Worker: uvicorn app:app（热重载，断点可能只在子进程生效）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "56790",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "DARKEYE_MAIN_BASE_URL": "http://127.0.0.1:56789"
      }
    }
  ]
}
